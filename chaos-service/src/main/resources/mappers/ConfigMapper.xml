<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chaos.service.mapper.ConfigMapper">

    <resultMap id="BaseResultMap" type="com.chaos.service.entity.dto.config.ConfigDto">
        <id column="id" property="id"/>
        <result column="config_key" property="configKey"/>
        <result column="config_value" property="configValue"/>
        <result column="config_description" property="configDescription"/>
        <result column="is_delete" property="isDelete"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- ==================== 标准查询方法 ==================== -->

    <select id="selectList" resultMap="BaseResultMap">
        SELECT id, config_key, config_value, config_description, create_time
        FROM p_config
        <where>
            is_delete = 0
            <if test="configKey != null and configKey != ''">
                AND config_key LIKE CONCAT('%', #{configKey}, '%')
            </if>
            <if test="configDescription != null and configDescription != ''">
                AND config_description LIKE CONCAT('%', #{configDescription}, '%')
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <select id="selectDetail" resultMap="BaseResultMap">
        SELECT id, config_key, config_value, config_description, create_time
        FROM p_config
        WHERE id = #{id} AND is_delete = 0
    </select>

    <!-- ==================== 业务自定义方法 ==================== -->

    <select id="selectByConfigKey" resultMap="BaseResultMap">
        SELECT * FROM p_config WHERE config_key = #{configKey} AND is_delete = 0
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM p_config WHERE is_delete = 0 ORDER BY create_time DESC
    </select>

</mapper>
