<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chaos.service.mapper.RoleMapper">

    <resultMap id="BaseResultMap" type="com.chaos.service.entity.dto.role.RoleDto">
        <id column="id" property="id"/>
        <result column="role_name" property="roleName"/>
        <result column="role_code" property="roleCode"/>
        <result column="description" property="description"/>
        <result column="sort" property="sort"/>
        <result column="status" property="status"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="del_flag" property="delFlag"/>
    </resultMap>

    <select id="selectByRoleCode" resultMap="BaseResultMap">
        SELECT * FROM sys_role WHERE role_code = #{roleCode} AND del_flag = 0
    </select>

    <select id="selectMenuIdsByRoleId" resultType="java.lang.Long">
        SELECT menu_id FROM sys_role_menu WHERE role_id = #{roleId}
    </select>

    <select id="selectRolesByAdminId" resultMap="BaseResultMap">
        SELECT r.*
        FROM sys_role r
        INNER JOIN sys_admin_role ar ON r.id = ar.role_id
        WHERE ar.admin_id = #{adminId} AND r.del_flag = 0
        ORDER BY r.sort
    </select>

</mapper>
