<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chaos.service.mapper.AttachmentMapper">

    <resultMap id="BaseResultMap" type="com.chaos.service.entity.dto.attachment.AttachmentDto">
        <id column="id" property="id"/>
        <result column="oid" property="oid"/>
        <result column="original_name" property="originalName"/>
        <result column="new_name" property="newName"/>
        <result column="suffix" property="suffix"/>
        <result column="size" property="size"/>
        <result column="cover" property="cover"/>
        <result column="origin_path" property="originPath"/>
        <result column="view_path" property="viewPath"/>
        <result column="duration" property="duration"/>
        <result column="upload_state" property="uploadState"/>
        <result column="state" property="state"/>
        <result column="note" property="note"/>
        <result column="biz_type" property="bizType"/>
        <result column="biz_id" property="bizId"/>
        <result column="is_delete" property="isDelete"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- ==================== 标准查询方法 ==================== -->

    <select id="selectList" resultMap="BaseResultMap">
        SELECT id, oid, original_name, new_name, suffix, size, cover, origin_path, view_path,
               duration, upload_state, state, note, biz_type, biz_id, create_time
        FROM p_attachment
        <where>
            is_delete = 0
            <if test="originName != null and originName != ''">
                AND original_name LIKE CONCAT('%', #{originName}, '%')
            </if>
            <if test="suffix != null and suffix != ''">
                AND suffix = #{suffix}
            </if>
            <if test="state != null">
                AND state = #{state}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <select id="selectDetail" resultMap="BaseResultMap">
        SELECT id, oid, original_name, new_name, suffix, size, cover, origin_path, view_path,
               duration, upload_state, state, note, biz_type, biz_id, create_time
        FROM p_attachment
        WHERE id = #{id} AND is_delete = 0
    </select>

    <!-- ==================== 业务自定义方法 ==================== -->

    <select id="selectByOid" resultMap="BaseResultMap">
        SELECT * FROM p_attachment WHERE oid = #{oid} AND is_delete = 0
    </select>

    <select id="selectByBiz" resultMap="BaseResultMap">
        SELECT * FROM p_attachment WHERE biz_type = #{bizType} AND biz_id = #{bizId} AND is_delete = 0
        ORDER BY create_time DESC
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM p_attachment WHERE is_delete = 0 ORDER BY create_time DESC
    </select>

</mapper>
