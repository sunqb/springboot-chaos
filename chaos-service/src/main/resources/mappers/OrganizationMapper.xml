<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chaos.service.mapper.OrganizationMapper">

    <resultMap id="BaseResultMap" type="com.chaos.service.entity.dto.org.OrganizationDto">
        <id column="id" property="id"/>
        <result column="parent_id" property="parentId"/>
        <result column="ancestors" property="ancestors"/>
        <result column="org_name" property="orgName"/>
        <result column="short_name" property="shortName"/>
        <result column="org_code" property="orgCode"/>
        <result column="leader" property="leader"/>
        <result column="phone" property="phone"/>
        <result column="email" property="email"/>
        <result column="sort" property="sort"/>
        <result column="status" property="status"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="del_flag" property="delFlag"/>
    </resultMap>

    <select id="selectAllOrdered" resultMap="BaseResultMap">
        SELECT * FROM sys_organization WHERE del_flag = 0 ORDER BY sort, id
    </select>

    <select id="selectByParentId" resultMap="BaseResultMap">
        SELECT * FROM sys_organization WHERE parent_id = #{parentId} AND del_flag = 0 ORDER BY sort, id
    </select>

    <select id="selectByOrgCode" resultMap="BaseResultMap">
        SELECT * FROM sys_organization WHERE org_code = #{orgCode} AND del_flag = 0
    </select>

</mapper>
