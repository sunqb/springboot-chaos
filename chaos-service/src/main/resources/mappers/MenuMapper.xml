<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chaos.service.mapper.MenuMapper">

    <resultMap id="BaseResultMap" type="com.chaos.service.entity.dto.menu.MenuDto">
        <id column="id" property="id"/>
        <result column="parent_id" property="parentId"/>
        <result column="menu_name" property="menuName"/>
        <result column="permission" property="permission"/>
        <result column="state" property="state"/>
        <result column="url" property="url"/>
        <result column="component" property="component"/>
        <result column="type" property="type"/>
        <result column="sort" property="sort"/>
        <result column="icon" property="icon"/>
        <result column="is_delete" property="isDelete"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <resultMap id="MenuVoResultMap" type="com.chaos.service.entity.vo.menu.MenuVo">
        <id column="id" property="id"/>
        <result column="parent_id" property="parentId"/>
        <result column="menu_name" property="menuName"/>
        <result column="permission" property="permission"/>
        <result column="state" property="state"/>
        <result column="url" property="url"/>
        <result column="component" property="component"/>
        <result column="type" property="type"/>
        <result column="sort" property="sort"/>
        <result column="icon" property="icon"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <!-- ==================== 标准查询方法 ==================== -->

    <select id="selectList" resultMap="MenuVoResultMap">
        SELECT id, parent_id, menu_name, permission, state, url, component, type, sort, icon, create_time
        FROM p_menu
        <where>
            is_delete = 0
            <if test="menuName != null and menuName != ''">
                AND menu_name LIKE CONCAT('%', #{menuName}, '%')
            </if>
            <if test="type != null and type != ''">
                AND type = #{type}
            </if>
            <if test="state != null">
                AND state = #{state}
            </if>
            <if test="parentId != null">
                AND parent_id = #{parentId}
            </if>
        </where>
        ORDER BY sort ASC, id ASC
    </select>

    <select id="selectDetail" resultMap="MenuVoResultMap">
        SELECT id, parent_id, menu_name, permission, state, url, component, type, sort, icon, create_time
        FROM p_menu
        WHERE id = #{id} AND is_delete = 0
    </select>

    <!-- ==================== 业务自定义方法 ==================== -->

    <select id="selectAllOrdered" resultMap="BaseResultMap">
        SELECT * FROM p_menu WHERE is_delete = 0 ORDER BY sort, id
    </select>

    <select id="selectMenusByRoleIds" resultMap="BaseResultMap">
        SELECT DISTINCT m.*
        FROM p_menu m
        INNER JOIN p_role_menu rm ON m.id = rm.menu_id
        WHERE rm.role_id IN
        <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
        AND m.state = 1 AND m.is_delete = 0
        ORDER BY m.sort, m.id
    </select>

    <select id="selectByParentId" resultMap="BaseResultMap">
        SELECT * FROM p_menu WHERE parent_id = #{parentId} AND is_delete = 0 ORDER BY sort, id
    </select>

    <select id="selectPublicMenus" resultMap="BaseResultMap">
        SELECT * FROM p_menu WHERE state = 1 AND is_delete = 0 ORDER BY sort, id
    </select>

</mapper>
